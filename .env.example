# --- Required ---------------------------------------------------------------
# Neon PostgreSQL pooled URL for this environment. Use a separate branch for development.
DATABASE_URL=
# Optional direct URL from the same Neon branch, used by migrations and admin scripts.
DATABASE_URL_UNPOOLED=
# Neon connections must use verified TLS.
DB_SSL=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
# sandbox | production. Sandbox shows the "simulate bank transfer" buttons. Production requires SMTP.
NEXT_PUBLIC_APP_ENV=sandbox
# true for HTTPS; set false only while testing over plain HTTP.
COOKIE_SECURE=false
# Optional social-proof section toggle.
NEXT_PUBLIC_SHOW_SOCIAL_PROOF=false
# Optional maximum number of pooled connections (1-50, default 5).
DB_POOL_MAX=5

# Random secrets, 32+ characters each. Generate with: openssl rand -hex 32
OTP_PEPPER=replace-with-a-random-64-character-hex-value
CRON_SECRET=replace-with-a-random-64-character-hex-value

# --- Email (required when NEXT_PUBLIC_APP_ENV=production) --------------------
# Any SMTP provider works (Gmail app password, Resend, Brevo...). Without these in sandbox,
# emails are written to ./.dev-outbox/ so you can read verification codes locally.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PaySafr <no-reply@yourdomain.com>"

# --- Payments ----------------------------------------------------------------
# simulator | paga
PAYMENT_MODE=simulator
# manual | paga
BANK_RESOLVER=manual
# sandbox | live
PAGA_ENV=sandbox
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=
# Set to true to rehearse failed payouts in the sandbox.
SIMULATOR_FAIL_PAYOUTS=false

# --- First admin (used only by `npm run seed:admin`; remove afterwards) -------
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
